DATABASE_URL=postgresql://optica:optica@localhost:5434/optica
# Base desechable para los e2e (se borra y resiembra en cada ejecución)
DATABASE_URL_TEST=postgresql://optica:optica@localhost:5434/optica_test
PORT=4000
CORS_ORIGIN=http://localhost:3010
SESSION_TTL_HOURS=12
# Zona horaria de la tienda: recordatorios, cumpleaños y la pantalla Hoy
SHOP_TZ=America/New_York
# PIN inicial del dueño (cámbialo tras el primer login) y equipo de prueba
SEED_OWNER_PIN=0000
SEED_DEMO=true
# Firma de los enlaces de baja (pon un valor largo y aleatorio en producción)
APP_SECRET=dev-secret-change-me
PUBLIC_API_URL=http://localhost:4000
# Correo (Resend) y SMS (Twilio). Sin claves, los mensajes se registran en modo prueba.
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Solo los dispositivos autorizados pueden entrar con PIN (false lo desactiva:
# desarrollo, o para recuperar el acceso si se pierde el único dispositivo)
DEVICE_TRUST=true
